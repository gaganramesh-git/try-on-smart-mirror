# Get this free at: aistudio.google.com  (needed for the generative backend)
GEMINI_API_KEY=your_gemini_api_key_here

# Google image model used by the generative saree-drape backend
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Try-on backend:
#   kolors      = garment-to-person VTON (best for MODEL-worn saree photos)
#   fal         = fal.ai Qwen-Image-Edit-Plus; drapes a FABRIC-ONLY saree (recommended)
#   generative  = Gemini image model that drapes a FABRIC-ONLY saree (needs paid credits)
#   auto        = pick per saree: fabric -> fal (or generative), model -> kolors
#   mock        = offline heuristic simulation (no network)
TRYON_BACKEND=auto

# fal.ai — generative drape for fabric-only sarees. Get a key at
# https://fal.ai/dashboard/keys  (~$0.03-0.04 per generated image)
FAL_KEY=
FAL_MODEL=fal-ai/qwen-image-edit-plus
KOLORS_SPACE_URL=https://kwai-kolors-kolors-virtual-try-on.hf.space
KOLORS_SEED=42
KOLORS_RANDOMIZE_SEED=false
KOLORS_MAX_RETRIES=3
KOLORS_RETRY_DELAY_SECONDS=20

# Try-on job durability: total attempts per cart item and pause between retries.
# Interrupted jobs (still below their attempt budget) are re-run on restart.
TRYON_MAX_ATTEMPTS=3
TRYON_RETRY_DELAY_SECONDS=10

# Flask
FLASK_SECRET_KEY=any-random-string-change-this

# Staff PIN for admin / staff-mode access (enforced server-side)
STAFF_PIN=1234

# Set to "true" only for local development — exposes the Werkzeug debugger
FLASK_DEBUG=false

# Max upload size in MB
MAX_UPLOAD_MB=10

# WebSocket allowed origins: "*" for local demo, or comma-separated URLs in prod
ALLOWED_ORIGINS=*
